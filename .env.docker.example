# ══════════════════════════════════════════════════════════════════════
# LARAS — template .env untuk deployment Docker (Phase G)
#
#   cp .env.docker.example .env      (Linux/macOS)
#   copy .env.docker.example .env    (Windows)
#
# File ini dibaca docker-compose.yml lewat `env_file: .env`, jadi JANGAN
# di-commit. .env sudah ada di .gitignore dan .dockerignore.
#
# Yang BERBEDA dari .env.example (dev non-Docker) ditandai [DOCKER].
# ══════════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────────
# WAJIB diganti. Generate yang kuat:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-yang-kuat

# [DOCKER] SELALU False di container. Debug mode dijalankan gunicorn
# tidak berguna, dan reloader-nya berinteraksi aneh dengan worker model
# gthread. Untuk debugging, jalankan app di host, bukan di container.
DEBUG=False

# ── Session ────────────────────────────────────────────────────────────
SESSION_LIFETIME_SECONDS=28800
# [DOCKER] Di-set "true" oleh docker-compose.yml di service `app`
# (TLS aktif). Nilai di sini hanya fallback bila menjalankan image
# tanpa compose.
#
# BILA mengaktifkan ALLOW_INSECURE_HTTP=true di bawah, WAJIB set ini
# "false" — cookie Secure di atas HTTP membuat login tidak akan pernah
# tersimpan. Entrypoint akan menolak start pada kombinasi kontradiktif.
SESSION_COOKIE_SECURE=true

# [DOCKER] Escape hatch debugging lokal TANPA TLS. Default "false" =
# app GAGAL START bila sertifikat tidak ada (fail closed). Set "true"
# HANYA untuk debugging lokal, dan sertakan SESSION_COOKIE_SECURE=false.
# Jangan pakai di produksi. Lihat README.md bagian 4.1.6.
ALLOW_INSECURE_HTTP=false

# ── Wazuh Manager API — Dev & Prod ─────────────────────────────────────
# [DOCKER] PENTING: "localhost" di dalam container menunjuk ke CONTAINER
# ITU SENDIRI, bukan ke host Anda. Bila Wazuh Manager berjalan di mesin
# Windows/host yang sama:
#     gunakan  host.docker.internal  (compose menambahkan host-gateway)
# Bila Wazuh di server lain, pakai IP/hostname yang bisa di-resolve dari
# jaringan container.
WAZUH_DEV_API_URL=https://host.docker.internal:55000
WAZUH_DEV_API_USER=wazuh
WAZUH_DEV_API_PASSWORD=wazuh
WAZUH_DEV_API_VERIFY_CERT=False

WAZUH_PROD_API_URL=https://host.docker.internal:55000
WAZUH_PROD_API_USER=wazuh
WAZUH_PROD_API_PASSWORD=wazuh
WAZUH_PROD_API_VERIFY_CERT=False

# ── MongoDB ────────────────────────────────────────────────────────────
# DUA MODE — pilih salah satu:
#
# (A) Mongo sebagai container (`--profile local-mongo`).
#     Hostname = nama service compose, yaitu `mongo`. Kredensial harus
#     SAMA dengan MONGO_ROOT_USER/MONGO_ROOT_PASSWORD di bawah.
MONGO_URI=mongodb://admin:admin@mongo:27017/?authSource=admin
#
# (B) Mongo eksternal (tanpa profile local-mongo).
#     Contoh: MONGO_URI=mongodb://user:pass@10.10.10.5:27017/?authSource=admin
#
# (C) MongoDB yang berjalan DI HOST (mis. instalasi lokal di Windows).
#     "localhost" di dalam container menunjuk ke container itu sendiri,
#     jadi WAJIB memakai host.docker.internal:
#     MONGO_URI=mongodb://host.docker.internal:27017/
#
# Nama DB harus SAMA dengan database yang sudah berisi data Anda. Bila
# berbeda, aplikasi akan tampak kosong (DB baru dibuat, data lama tidak
# terlihat). Default template ini hanya contoh.
MONGO_DB_NAME=wazuh_rule_management
SESSION_MONGODB_DB=wazuh_rule_management

# Kredensial container Mongo (hanya dipakai bila mode A).
#
# ⚠️  DEFAULT TIDAK AMAN. `admin/admin` hanya untuk uji lokal di mesin
#     sendiri. WAJIB diganti sebelum deploy ke jaringan/Server apa pun.
#     Ganti MONGO_ROOT_PASSWORD, lalu samakan password di MONGO_URI di
#     atas — keduanya harus identik, kalau tidak aplikasi gagal konek.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin
# [DOCKER] Port di host untuk akses Compass/mongosh. Di-bind ke 127.0.0.1
# saja oleh compose — tidak terekspos ke jaringan.
MONGO_PORT=27017

# ── Backup (S3/MinIO) ──────────────────────────────────────────────────
BACKUP_ENABLED=False

# [DOCKER] Endpoint S3 dilihat dari DALAM container.
#
# (A) MinIO sebagai container (`--profile local-minio`):
#     hostname = nama service, yaitu `minio`, port internal 9000.
S3_ENDPOINT_URL=http://minio:9000
#
# (B) MinIO/S3 eksternal:
#     S3_ENDPOINT_URL=https://s3.internal.example.com
#     (jangan pakai localhost — lihat catatan Wazuh di atas)
#
# ⚠️  DEFAULT TIDAK AMAN. `minioadmin/minioadmin` adalah kredensial
#     bawaan MinIO dan dikenal publik. WAJIB diganti sebelum deploy ke
#     jaringan mana pun.
#     Catatan penting: pada profile `local-minio`, dua nilai ini JUGA
#     menjadi MINIO_ROOT_USER/MINIO_ROOT_PASSWORD. Menggantinya berarti
#     kredensial MinIO ikut berubah — tidak ada yang perlu disesuaikan
#     lagi selain keduanya.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=laras-backups
S3_REGION=
S3_PREFIX=backups
BACKUP_CRON=0 2 * * *
BACKUP_COLLECTIONS=rules,decoders,rule_history,decoder_history,promotion_requests,users,manager_actions

# [DOCKER] Port MinIO di host (bind 127.0.0.1 oleh compose).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# [DOCKER] Zona waktu container. WAJIB benar agar BACKUP_CRON dan
# KEV_SYNC_CRON dievaluasi pada jam lokal yang Anda maksud — APScheduler
# memakai zona waktu container, bukan UTC. Image sudah menyertakan tzdata.
TZ=Asia/Jakarta

# ── Notifications (Telegram) ───────────────────────────────────────────
# Kosongkan keduanya untuk menonaktifkan notifikasi (app tetap normal).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── KEV feed (Phase F) ─────────────────────────────────────────────────
KEV_SYNC_ENABLED=False
KEV_SYNC_CRON=15 */6 * * *

# ── LLM (AI rule proposal) ─────────────────────────────────────────────
LLM_PROVIDER_URL=https://kiyararouter.web.id/v1
LLM_MODEL=z-ai/glm-5.3
LLM_API_KEY=
AI_PROPOSAL_ENABLED=False
AI_PROPOSAL_CRON=30 */6 * * *
AI_PROPOSAL_MAX_PER_RUN=10


# ── Scheduler election ─────────────────────────────────────────────────
# [DOCKER] Nilai di sini TIDAK menentukan siapa yang jalan — compose
# memaksa `app`=false dan `scheduler`=true lewat blok `environment:`
# (environment menang atas env_file). Baris ini hanya fallback untuk
# `docker run` tanpa compose. Lihat docker-compose.yml.
SCHEDULER_ENABLED=false

# ── Port publik HTTPS ──────────────────────────────────────────────────
# [DOCKER] Port di host yang memetakan ke 5000 container (HTTPS).
# Akses: https://localhost:5000
APP_HTTPS_PORT=5000
# ── Exploit-DB (Phase F: exploit enrichment) ───────────────────────────
# Aktifkan enrichment exploit di pipeline AI (satu lookup per CVE).
# Endpoint manual tetap bisa dipakai walau False.
EXPLOITDB_ENABLED=False

# Batas hasil: metadata per CVE, dan berapa exploit teratas yang kodenya
# diambil (0 = metadata saja).
EXPLOITDB_MAX_RESULTS=5
EXPLOITDB_MAX_CODE_FETCH=2

# Retry antrean (default mengikuti EXPLOITDB_ENABLED).
# EXPLOITDB_RETRY_ENABLED=True
EXPLOITDB_RETRY_CRON=* * * * *

# Refresh sweep: cek ulang proposal pending bila ada exploit baru.
EXPLOITDB_REFRESH_ENABLED=False
EXPLOITDB_REFRESH_CRON=0 3 * * *
