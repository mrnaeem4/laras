# ══════════════════════════════════════════════════════════════════════
# LARAS — template .env untuk menjalankan aplikasi di HOST (non-container)
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# Hanya variabel yang PERLU diatur yang dicantumkan di sini. Nilai
# internal (endpoint layanan pihak ketiga, user agent, timeout, batas
# rate limiter, TTL cache, dsb.) punya default yang benar di config.py
# dan sengaja tidak diduplikasi di template — mengubahnya tidak lazim
# dan hanya diperlukan untuk kasus khusus.
#
# Untuk deployment Docker, gunakan .env.docker.example.
# ══════════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────────
# Secret key untuk session Flask. Ganti dengan string acak yang kuat
# di lingkungan produksi.
SECRET_KEY=ganti-dengan-string-acak-yang-kuat

# Mode debug. Set ke False di produksi.
DEBUG=True

# ── Session (server-side, disimpan di MongoDB) ─────────────────────────
# Umur session dalam detik. Default 8 jam — cukup untuk satu shift SOC.
SESSION_LIFETIME_SECONDS=28800

# Nama database tempat session disimpan. Bila dikosongkan, aplikasi
# memakai MONGO_DB_NAME (perilaku default).
SESSION_MONGODB_DB=wazuh_rule_management

# Set True HANYA bila aplikasi benar-benar disajikan via HTTPS.
# Bila True tetapi diakses lewat http://, browser menolak menyimpan cookie
# session sehingga login tampak "tidak menempel" (langsung logout).
SESSION_COOKIE_SECURE=False

# ── Wazuh Manager API — Dev (Phase C) ──────────────────────────────────
# URL Wazuh Manager Dev API (default port 55000)
WAZUH_DEV_API_URL=https://dev-wazuh:55000

# Kredensial Wazuh Dev API
WAZUH_DEV_API_USER=wazuh
WAZUH_DEV_API_PASSWORD=wazuh

# Verifikasi sertifikat SSL Dev.
# Set ke False jika Wazuh menggunakan self-signed certificate (umum
# pada instalasi default). Set ke True di produksi dengan CA resmi.
WAZUH_DEV_API_VERIFY_CERT=False

# ── Wazuh Manager API — Prod (Phase C) ─────────────────────────────────
# WAJIB diisi eksplisit — tidak ada fallback ke WAZUH_API_* lama.
WAZUH_PROD_API_URL=https://prod-wazuh:55000
WAZUH_PROD_API_USER=wazuh
WAZUH_PROD_API_PASSWORD=wazuh
WAZUH_PROD_API_VERIFY_CERT=False

# ── MongoDB ────────────────────────────────────────────────────────────
# URI koneksi MongoDB. Ganti sesuai konfigurasi server MongoDB Anda.
# Contoh dengan auth: mongodb://user:password@host:27017/
MONGO_URI=mongodb://localhost:27017/

# Nama database MongoDB yang digunakan aplikasi.
MONGO_DB_NAME=wazuh_rule_management

# ── Backup (Phase E) ───────────────────────────────────────────────────
# Aktifkan fitur backup (scheduler otomatis + endpoint on-demand).
BACKUP_ENABLED=False

# S3-compatible storage (MinIO / AWS S3).
# Contoh MinIO lokal: http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=laras-backups
S3_REGION=
S3_PREFIX=backups

# Cron untuk backup otomatis (5-field: menit jam hari bulan hari_minggu).
# Default: setiap hari pukul 02:00.
BACKUP_CRON=0 2 * * *

# Koleksi yang ikut di-backup (dipisah koma).
BACKUP_COLLECTIONS=rules,decoders,rule_history,decoder_history,promotion_requests,users,manager_actions

# ── Notifications (Phase E) ────────────────────────────────────────────
# Telegram bot. Kosongkan kedua nilai ini untuk menonaktifkan notifikasi.
# Buat bot via @BotFather, lalu dapatkan chat ID Anda.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── KEV feed (Phase F) ─────────────────────────────────────────────────
# Sinkronisasi katalog vendor/product dari feed KEV (sumber dropdown
# Tech Stack) dan bahan usulan rule AI.
KEV_SYNC_ENABLED=False

# Jadwal sync katalog vendor/product (5-field cron).
# Default: setiap 6 jam pada menit 15 (00:15, 06:15, 12:15, 18:15).
KEV_SYNC_CRON=15 */6 * * *

# ── LLM (Phase F: AI rule proposal) ────────────────────────────────────
# Provider OpenAI-compatible. Base URL TANPA /chat/completions.
LLM_PROVIDER_URL=https://kiyararouter.web.id/v1
LLM_MODEL=z-ai/glm-5.3
LLM_API_KEY=

# Pipeline AI terjadwal: usulan draft rule dari KEV yang relevan dengan tech
# stack. False -> tidak dijadwalkan (endpoint manual tetap bisa dipakai).
AI_PROPOSAL_ENABLED=False
AI_PROPOSAL_CRON=30 */6 * * *
# Batas usulan baru per run (jaga biaya token + hindari banjir draft).
AI_PROPOSAL_MAX_PER_RUN=10

# ── Exploit-DB (Phase F: exploit enrichment) ───────────────────────────
# Aktifkan enrichment exploit di pipeline AI (satu lookup per CVE).
# Endpoint manual tetap bisa dipakai walau False.
EXPLOITDB_ENABLED=False

# Batas hasil: metadata per CVE, dan berapa exploit teratas yang kodenya
# diambil (0 = metadata saja).
EXPLOITDB_MAX_RESULTS=5
EXPLOITDB_MAX_CODE_FETCH=2

# Retry antrean (default mengikuti EXPLOITDB_ENABLED).
# EXPLOITDB_RETRY_ENABLED=True
EXPLOITDB_RETRY_CRON=* * * * *

# Refresh sweep: cek ulang proposal pending bila ada exploit baru.
EXPLOITDB_REFRESH_ENABLED=False
EXPLOITDB_REFRESH_CRON=0 3 * * *

# ── Scheduler election ─────────────────────────────────────────────────
# Biarkan True untuk deployment satu-proses (dev / waitress satu worker).
# Di deployment multi-worker (gunicorn -w N), set False di SEMUA worker
# kecuali satu, supaya job cron tidak berjalan sekali per worker.
SCHEDULER_ENABLED=True
